---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { getEntry } from "astro:content";

export const prerender = true;

export async function getStaticPaths() {
    const projects = await getCollection("projects");
    return projects.map((project) => ({
        params: { slug: project.id },
    }));
}

const { slug } = Astro.params;

if (!slug) {
    throw new Error("Slug is missing");
}

const entry = await getEntry("projects", slug);

if (!entry) {
    return Astro.redirect("/404");
}

const { Content } = await render(entry);
---

<script>
    import { animate, type AnimationSequence } from "motion";
    import { loaderAnimation } from "../../lib/constants";

    const sequence = [loaderAnimation];

    animate(sequence as AnimationSequence);
</script>

<Layout
    description={entry.data.description}
    title={`${entry.data.title} | Kaustav Bhattacharya`}
>
    <main
        class="w-screen h-screen flex flex-col justify-start items-start max-w-4xl mx-auto p-4 md:p-8 overflow-y-auto"
    >
        <a
            class="text-white bg-neutral-900 hover:bg-neutral-800 px-4 py-2 mb-8 border-1 border-solid border-neutral-600 rounded-lg transition-colors duration-300"
            href="/projects"
            aria-label="Back"
        >
            Back
        </a>

        <div class="w-full flex flex-col gap-6">
            {
                entry.data.image && (
                    <div class="w-full h-[220px] md:h-[320px] rounded-2xl overflow-hidden bg-neutral-800 border border-neutral-700">
                        <img
                            src={entry.data.image}
                            alt={entry.data.title}
                            class="w-full h-full object-cover"
                        />
                    </div>
                )
            }

            <div class="w-full">
                <h1 class="text-3xl md:text-5xl font-bold mb-4 text-white">
                    {entry.data.title}
                </h1>
                <p
                    class="text-xl text-neutral-300 font-light mb-6 border-l-4 border-red-500 pl-4"
                >
                    {entry.data.description}
                </p>

                {
                    entry.data.demoUrl && (
                        <a
                            href={entry.data.demoUrl}
                            target="_blank"
                            rel="noreferrer noopener"
                            class="inline-block bg-white text-black font-bold py-2 px-6 rounded-full hover:bg-neutral-200 transition-colors mb-8"
                        >
                            Demo
                        </a>
                    )
                }

                <article
                    class="prose prose-invert prose-lg max-w-none text-white prose-headings:text-neutral-100 prose-p:text-neutral-300 prose-li:text-neutral-300 prose-strong:text-white font-[Satoshi]"
                >
                    <Content />
                </article>
            </div>
        </div>
    </main>
</Layout>
